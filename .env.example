# ── Runtime
NODE_ENV=development
APP_ROLE=api                       # api | worker | scheduler
PORT=3000
PUBLIC_API_URL=http://localhost:3000
CMS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# ── Database / Redis (docker-compose defaults)
DATABASE_URL=postgresql://wehum:wehum@localhost:5432/wehum
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
# ── JWT keys: run `npm run keys` and paste the output here
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEYS_B64=
JWT_KID=k1
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=60
ADMIN_ACCESS_TTL_SEC=600
ADMIN_REFRESH_IDLE_HOURS=12
TOTP_ENC_KEY_BASE64=
# ── App versions
MIN_APP_VERSION_IOS=1.0.0
MIN_APP_VERSION_ANDROID=1.0.0
# ── Sign in
APPLE_BUNDLE_IDS=app.wehum.meditation,app.wehum.meditation.staging,app.wehum.meditation.dev
GOOGLE_CLIENT_IDS=
FIREBASE_PROJECT_ID=wehum-a7fc5
# ── Email (Mailpit locally: http://localhost:8025)
MAIL_FROM="WeHum <hello@wehum.app>"
SMTP_URL=smtp://localhost:1025
APP_LINK_BASE=https://wehum.app
# CMS base URL used in invite / reset-password emails
ADMIN_APP_URL=http://localhost:5173
# ── RevenueCat
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY_V2=
REVENUECAT_PROJECT_ID=
# ── Storage / CDN (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=wehum-media-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
CDN_BASE_URL=http://localhost:9000/wehum-media-dev
# Premium media URLs are HMAC-signed with this secret (mandatory in staging/production)
CDN_SIGNING_SECRET=dev-only-cdn-secret
S3_FORCE_PATH_STYLE=true
# ffmpeg / ffprobe for the media worker (installed in the Docker image)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional: YouTube Data API key (duration + embeddable check when resolving links in the CMS)
YOUTUBE_API_KEY=
# ── Push (FCM transport only)
FCM_SERVICE_ACCOUNT_JSON=
# ── Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# ── Seed (first CMS owner)
SEED_OWNER_EMAIL=owner@wehum.app
SEED_OWNER_PASSWORD=ChangeMe-2026!
