# /opt/wehum/.env on the server — filled by deploy.sh (secrets generated there, never committed)
CMS_HOST=__CMS_HOST__
API_HOST=__API_HOST__
# the CMS (cms.…) reads the CSRF cookie set by the API (api.…)
ADMIN_COOKIE_DOMAIN=__COOKIE_DOMAIN__
NODE_ENV=staging
LOG_LEVEL=info
POSTGRES_PASSWORD=__PG_PASSWORD__
DATABASE_URL=postgresql://wehum:__PG_PASSWORD__@postgres:5432/wehum
REDIS_URL=redis://redis:6379
PUBLIC_API_URL=https://__API_HOST__
CMS_ORIGINS=https://__CMS_HOST__
ADMIN_APP_URL=https://__CMS_HOST__
APP_LINK_BASE=https://wehum.app
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://__API_HOST__:9443
S3_BUCKET=wehum-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=wehum
S3_SECRET_KEY=__S3_SECRET__
CDN_BASE_URL=https://__API_HOST__:9443/wehum-media
CDN_SIGNING_SECRET=__CDN_SECRET__
METRICS_TOKEN=__METRICS_TOKEN__
SEED_OWNER_EMAIL=raphael@wehum.app
SEED_OWNER_PASSWORD=__OWNER_PASSWORD__
SMTP_URL=
