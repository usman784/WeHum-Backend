# Two hosts, HTTPS by Let's Encrypt:
#   CMS_HOST (cms.wehum.app) → the CMS build (SPA fallback)
#   API_HOST (api.wehum.app) → the API: REST, Socket.IO, webhooks; storage (MinIO) on port 9443 with the Host kept,
#   so presigned upload URLs stay valid. /metrics and /docs are not reachable from outside.
{$CMS_HOST} {
	encode zstd gzip
	root * /srv/cms
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

{$API_HOST} {
	encode zstd gzip
	@blocked path /metrics /docs /docs/*
	respond @blocked 404
	reverse_proxy api:3000
}

{$API_HOST}:9443 {
	reverse_proxy minio:9000
}
