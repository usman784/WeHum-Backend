# One host for everything (same origin, so the CMS cookies and CORS stay simple):
#   /v1/*, /socket.io/*, /webhooks/*, /healthz, /readyz → API ; everything else → the CMS build (SPA fallback).
# Storage (MinIO) has its own HTTPS port 9443 with the Host header kept, so presigned upload URLs stay valid.
{$SITE_HOST} {
	encode zstd gzip
	@blocked path /metrics /docs /docs/*
	respond @blocked 404
	@api path /v1/* /socket.io/* /webhooks/* /healthz /readyz
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/cms
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

{$SITE_HOST}:9443 {
	reverse_proxy minio:9000
}
